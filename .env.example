# ---------------------------------------------------------------------------
# Lemur deployment environment variables.
#
# Copy this file to `.env` (it is gitignored) and fill in the real values,
# then run `docker compose up`. The `.env` file is the single place where the
# deployment secrets live -- nothing is committed to the repository.
#
# The two blocks below MUST use the same values: the LEMUR_DB_* variables are
# what the R Shiny app and the Python API read at runtime, and the POSTGRES_*
# variables are what the `postgres` container uses to create that same role
# and database. If they disagree the app will fail to authenticate.
# ---------------------------------------------------------------------------

# --- PostgreSQL server -----------------------------------------------------
# Used by the `postgres` container to initialise the database role, database
# and the cod/sdg/lt tables (see deploy/postgresql/init-db.sh).
POSTGRES_USER=lemur
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gbd2021

# --- Lemur app database connection (R Shiny app + Python API) --------------
# Must match the POSTGRES_* values above. In a cloud deployment the host will
# not be "postgres" -- set it to the managed database endpoint.
LEMUR_DB_HOST=postgres
LEMUR_DB_NAME=gbd2021
LEMUR_DB_USER=lemur
LEMUR_DB_PASSWORD=change-me
LEMUR_DB_PORT=5432

# ---------------------------------------------------------------------------
# Lemur deployment environment variables.
#
# Copy this file to `.env` (it is gitignored) and fill in the real values,
# then run `docker compose up`. The `.env` file is the single place where the
# deployment secrets live -- nothing is committed to the repository.
#
# The deployment uses THREE separate database roles, with three separate
# passwords. They must all differ -- init-db.sh refuses to initialise the
# database otherwise.
#
#   POSTGRES_USER      superuser. Creates the database, then never connects
#                      over the network again. A Postgres superuser can run
#                      arbitrary shell commands inside the postgres container
#                      (COPY ... FROM PROGRAM, lo_export, untrusted PLs), so
#                      no other container is given this password, and
#                      init-db.sh adds a pg_hba.conf rule rejecting it over
#                      TCP entirely.
#   LEMUR_DB_OWNER     owns the schema and tables. NOSUPERUSER. Used only by
#                      the one-shot db-loader, which needs DDL.
#   LEMUR_DB_USER      the runtime role for the Shiny app and the API.
#                      SELECT on the data tables and SELECT/INSERT/UPDATE on
#                      api_requests. No DDL, no DELETE.
# ---------------------------------------------------------------------------

# --- PostgreSQL superuser (container init only) ----------------------------
# Read by the `postgres` container alone. Do not reuse this anywhere else.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=gbd_lemur_db

# --- Schema owner (db-loader only) -----------------------------------------
# Read by the `postgres` container (to create the role) and the `db-loader`
# service (to write the cod/sdg/lt tables). Not given to the app or the API.
LEMUR_DB_OWNER=lemur_owner
LEMUR_DB_OWNER_PASSWORD=change-me-owner

# --- Lemur app database connection (R Shiny app + Python API) --------------
# The least-privilege runtime role. In a cloud deployment the host will not
# be "postgres" -- set it to the managed database endpoint.
LEMUR_DB_HOST=postgres
LEMUR_DB_NAME=gbd_lemur_db
LEMUR_DB_USER=lemur_app
LEMUR_DB_PASSWORD=change-me-app
LEMUR_DB_PORT=5432
